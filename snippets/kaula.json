      "match (${1:expression}) {",
      "\t${2:Pattern} => ${3:result},",
      "\t_ => ${4:default},",
      "}"
    ],
    "description": "Pattern matching expression"
  },
  "Extern Function": {
    "prefix": "externfn",
    "body": "extern fn ${1:name}(${2:params}) -> ${3:void}",
    "description": "External function declaration"
  },
  "Extern Variable": {
    "prefix": "externvar",
    "body": "extern ${1:name}: ${2:u8}",
    "description": "External variable declaration"
  },
  "Comptime Expression": {
    "prefix": "comptime",
    "body": "comptime(${1:expr})",
    "description": "Compile-time evaluation"
  },
  "Sizeof": {
    "prefix": "sizeof",
    "body": "sizeof(${1:Type})",
    "description": "Size of type in bytes"
  },
  "Alignof": {
    "prefix": "alignof",
    "body": "alignof(${1:Type})",
    "description": "Alignment of type in bytes"
  },
  "Offsetof": {
    "prefix": "offsetof",
    "body": "offsetof(${1:Type}, ${2:field})",
    "description": "Offset of field in struct"
  },
  "Type Name": {
    "prefix": "typename",
    "body": "type_name(${1:expr})",
    "description": "Get type name at compile time"
  },
  "Volatile Load": {
    "prefix": "vload",
    "body": "#[volatile_load(${1:addr})]",
    "description": "Volatile memory read (MMIO)"
  },
  "Volatile Store": {
    "prefix": "vstore",
    "body": "#[volatile_store(${1:addr}, ${2:value})]",
    "description": "Volatile memory write (MMIO)"
  },
  "Atomic Load": {
    "prefix": "atomicload",
    "body": "#[atomic_load(${1:ptr})]",
    "description": "Atomic load operation"
  },
  "Atomic Store": {
    "prefix": "atomicstore",
    "body": "#[atomic_store(${1:ptr}, ${2:value})]",
    "description": "Atomic store operation"
  },
  "Atomic CAS": {
    "prefix": "atomiccas",
    "body": "#[atomic_cas(${1:ptr}, ${2:expected}, ${3:new_val})]",
    "description": "Atomic compare-and-swap"
  },
  "Atomic Fetch-Add": {
    "prefix": "atomicfaa",
    "body": "#[atomic_faa(${1:ptr}, ${2:delta})]",
    "description": "Atomic fetch-and-add"
  },
  "Memory Fence": {
    "prefix": "fence",
    "body": "#[fence()]",
    "description": "Memory barrier (full fence)"
  },
  "Inline Assembly": {
    "prefix": "asm",
    "body": "#[asm(\"${1:instruction}\")]",
    "description": "Inline assembly expression"
  },
  "Function Type Alias": {
    "prefix": "fntype",
    "body": "type ${1:Callback} = fn(${2:params}) -> ${3:ReturnType}",
    "description": "Function type alias"
  }
}