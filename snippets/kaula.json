      "fn ${1:process_data}(${2:input}: []${3:Item}) ${4:Result} {",
      "\t// 所有权转移示例",
      "\tauto ${5:owned} = yield(${2:input})",
      "\t",
      "\t// 分发只读视图",
      "\tauto ${6:view_a}, ${7:view_b} = release(${5:owned})",
      "\t",
      "\t// 提取子元素",
      "\tauto ${8:elem} = extract(${5:owned}[0])",
      "\t",
      "\t$0",
      "\treturn ${5:owned}",
      "}"
    ],
    "description": "Full SOR function template with yield/release/extract"
